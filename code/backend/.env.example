# Server & CORS Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENABLE_SWAGGER=true

# Database & Redis
DATABASE_URL="postgresql://postgres:password@localhost:5432/eduai_db?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/eduai_db?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication & Security (BR-AUTH-001)
JWT_SECRET="replace_with_strong_random_jwt_secret"
JWT_EXPIRES_IN="4h"
PASSWORD_PEPPER="replace_with_strong_random_password_pepper"
ENABLE_EMAIL_2FA=false
MAIL_USER="your_email@gmail.com"
MAIL_PASS="your_app_password"

# AI Adapter & Vector Store Configuration (GEMINI.md Section 8)
# Chế độ AI: Đặt AI_PROVIDER="GROQ" (miễn phí, siêu nhanh, ổn định 24/7), "OLLAMA" (Qwen3-8B tự huấn luyện trên Colab/HuggingFace), hoặc "GEMINI"
AI_PROVIDER="GROQ"
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_VISION_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"

OLLAMA_BASE_URL="https://your-colab-tunnel-url.trycloudflare.com"
OLLAMA_MODEL="qwen3-8b-ai-tutor-vn"
OLLAMA_EMBEDDING_MODEL="bge-m3"

# Fallback / Embedding Cloud AI Provider Configuration
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_VISION_MODEL="gemini-3.5-flash-lite"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PRIVATE_KEY="your_supabase_service_role_key"

