# Server & CORS Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENABLE_SWAGGER=true

# Database & Redis
DATABASE_URL="postgresql://postgres:password@localhost:5432/eduai_db?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/eduai_db?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication & Security (BR-AUTH-001)
JWT_SECRET="replace_with_strong_random_jwt_secret"
JWT_EXPIRES_IN="4h"
PASSWORD_PEPPER="replace_with_strong_random_password_pepper"
ENABLE_EMAIL_2FA=false
MAIL_USER="your_email@gmail.com"
MAIL_PASS="your_app_password"

# AI Adapter & Vector Store Configuration (GEMINI.md Section 8)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-1.5-pro-latest"
GEMINI_VISION_MODEL="gemini-1.5-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PRIVATE_KEY="your_supabase_service_role_key"

