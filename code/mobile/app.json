{
  "expo": {
    "name": "AI Tutor",
    "slug": "ai-tutor-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aitutor",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.aitutor.mobile",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.aitutor.mobile",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/07a8b6b3-b442-4f58-97de-df32e28ac12f",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://ai-tutor-ladg.onrender.com",
      "router": {},
      "eas": {
        "projectId": "07a8b6b3-b442-4f58-97de-df32e28ac12f"
      }
    }
  }
}